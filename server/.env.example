NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://giftcard:giftcard@localhost:5432/giftcard

# Public URL of the React app; used in email links and the CSRF origin check.
APP_URL=http://localhost:5173

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# console = print emails to the server log; smtp = send via SMTP (Mailpit in docker-compose)
MAIL_TRANSPORT=console
MAIL_FROM="Gift Cards <no-reply@giftcards.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Number of reverse proxies in front of the app (for correct client IPs / HTTPS detection)
TRUST_PROXY=0
