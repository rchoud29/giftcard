generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique // stored lowercased
  passwordHash      String // argon2id
  firstName         String
  lastName          String
  phoneEncrypted    String? // AES-256-GCM, see src/security/fieldCrypto.ts
  emailVerifiedAt   DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions       Session[]
  emailTokens    EmailToken[]
  securityEvents SecurityEvent[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique // SHA-256 of the cookie value; raw token is never stored
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

enum SecurityEventType {
  REGISTERED
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  PROFILE_UPDATED
}

model SecurityEvent {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SecurityEventType
  ip        String?
  userAgent String?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
}
